# Copie para .env.local e preencha. Com acesso ao projeto na Vercel: `vercel env pull .env.local`.

# Postgres (Neon). Use um banco/branch de desenvolvimento, não o de produção.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Vercel Blob (fotos enviadas pelo admin)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Login do painel /admin
AUTH_SECRET="string-aleatoria-com-48+-caracteres"   # node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_EMAIL="admin@imperiodasrosas.com.br"
# Gere com: npm run admin:senha -- "sua-senha". No .env.local os $ precisam de barra: \$
ADMIN_PASSWORD_HASH="\$2b\$12\$..."

# URL pública (sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

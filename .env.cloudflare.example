# Copie para .env.cloudflare (fica fora do git) e preencha com os valores de PRODUÇÃO.
# Usado por scripts/deploy-cloudflare.sh.

# Mesmo banco que o site usa hoje (Vercel → Settings → Environment Variables → DATABASE_URL, Production)
DATABASE_URL=""

# Login do painel /admin — os mesmos valores que estão na Vercel.
# Aqui o hash vai entre aspas SIMPLES, sem barra antes do $.
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=''

# Opcional: em branco, o script gera um novo (só desloga quem estiver no painel).
AUTH_SECRET=""

NEXT_PUBLIC_SITE_URL="https://imperiodasrosas.com"
